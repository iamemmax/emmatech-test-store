{
  "name": "back-test",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:types\"",
    "dev:server": "nodemon --watch src --ext ts,json --exec \"tsx src/server.ts\"",
    "dev:types": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "tsx src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "morgan": "^1.11.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
